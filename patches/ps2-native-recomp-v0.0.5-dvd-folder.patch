diff --git a/runtime/src/toca_dvd_directory.hpp b/runtime/src/toca_dvd_directory.hpp
new file mode 100644
--- /dev/null
+++ b/runtime/src/toca_dvd_directory.hpp
@@ -0,0 +1,182 @@
+#pragma once
+
+#include "ps2/disc.hpp"
+#include "ps2/os.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <memory>
+#include <string_view>
+
+#ifdef _WIN32
+#include <share.h>
+#endif
+
+namespace ps2::disc {
+
+// An ISO 9660 view of the extracted files. Keep the original file sectors so
+// the game's raw archive reads still land in the right files.
+class TocaDvdDirectory {
+public:
+    bool open(const std::string &path) {
+        const auto root = os::path(path);
+        extents_.reserve(std::size(kFiles));
+        for (const auto &entry : kFiles) {
+            const auto file_path = root / entry.path;
+            std::error_code error;
+            const auto size = std::filesystem::file_size(file_path, error);
+            if (error || size != entry.size) {
+                std::fprintf(stderr, "[disc] %s: expected a readable %u-byte file\n",
+                             os::utf8(file_path).c_str(), entry.size);
+                return false;
+            }
+#ifdef _WIN32
+            File file(_wfsopen(file_path.c_str(), L"rb", _SH_DENYWR), std::fclose);
+#else
+            File file(std::fopen(file_path.c_str(), "rb"), std::fclose);
+#endif
+            if (!file) {
+                std::fprintf(stderr, "[disc] %s: cannot open for reading\n", os::utf8(file_path).c_str());
+                return false;
+            }
+            const auto start = static_cast<std::uint64_t>(entry.sector) * kSector;
+            extents_.push_back({start, start + entry.size, std::move(file)});
+        }
+        return build_metadata();
+    }
+
+    std::uint64_t size() const { return static_cast<std::uint64_t>(kSectors) * kSector; }
+
+    std::size_t read(std::uint64_t offset, void *output, std::size_t count) {
+        if (offset >= size()) return 0;
+        const auto wanted = static_cast<std::size_t>(std::min<std::uint64_t>(count, size() - offset));
+        const auto end = offset + wanted;
+        auto *out = static_cast<std::uint8_t *>(output);
+        std::memset(out, 0, wanted);
+        if (offset < metadata_.size()) {
+            const auto length = static_cast<std::size_t>(std::min<std::uint64_t>(end, metadata_.size()) - offset);
+            std::memcpy(out, metadata_.data() + offset, length);
+        }
+        auto extent = std::lower_bound(extents_.begin(), extents_.end(), offset,
+                                       [](const Extent &file, auto at) { return file.end <= at; });
+        for (; extent != extents_.end() && extent->start < end; ++extent) {
+            const auto start = std::max(offset, extent->start);
+            const auto length = static_cast<std::size_t>(std::min(end, extent->end) - start);
+            if (std::fseek(extent->file.get(), static_cast<long>(start - extent->start), SEEK_SET) != 0) return start - offset;
+            const auto got = std::fread(out + (start - offset), 1, length, extent->file.get());
+            if (got != length) return start - offset + got;
+        }
+        return wanted;
+    }
+
+private:
+    struct FileEntry { std::uint32_t sector, size; const char *path; };
+    static constexpr FileEntry kFiles[] = {
+#include "toca_dvd_files.inc"
+    };
+    static constexpr std::uint32_t kSectors = 2293888;
+    static constexpr std::uint32_t kRoot = 20;
+    static constexpr std::string_view kDirectories[] = {
+        "", "CNF", "LICENSE", "MODULES", "NETGUI", "MODULES/SCEA", "NETGUI/IOPMODS"
+    };
+    using File = std::unique_ptr<std::FILE, decltype(&std::fclose)>;
+    struct Extent { std::uint64_t start, end; File file; };
+    struct Record { std::string name; std::uint32_t sector, size; bool directory; };
+    std::vector<Extent> extents_;
+    std::array<std::uint8_t, (kRoot + std::size(kDirectories)) * kSector> metadata_{};
+
+    static std::string_view parent(std::string_view path) {
+        const auto slash = path.rfind('/');
+        return slash == path.npos ? std::string_view{} : path.substr(0, slash);
+    }
+    static std::string_view filename(std::string_view path) {
+        const auto slash = path.rfind('/');
+        return slash == path.npos ? path : path.substr(slash + 1);
+    }
+    static std::uint32_t directory_index(std::string_view path) {
+        return static_cast<std::uint32_t>(std::find(std::begin(kDirectories), std::end(kDirectories), path) -
+                                          std::begin(kDirectories));
+    }
+    static void integer(std::uint8_t *out, std::uint32_t value, unsigned bytes, bool big) {
+        for (unsigned i = 0; i < bytes; ++i) out[big ? bytes - i - 1 : i] = static_cast<std::uint8_t>(value >> (i * 8));
+    }
+    static void both(std::uint8_t *out, std::uint32_t value, unsigned bytes) {
+        integer(out, value, bytes, false);
+        integer(out + bytes, value, bytes, true);
+    }
+    static std::size_t record_size(const Record &entry) { return (34 + entry.name.size()) & ~std::size_t{1}; }
+    static void record(std::uint8_t *out, const Record &entry) {
+        out[0] = static_cast<std::uint8_t>(record_size(entry));
+        both(out + 2, entry.sector, 4);
+        both(out + 10, entry.size, 4);
+        const std::uint8_t date[] = {104, 1, 1, 0, 0, 0, 0};
+        std::memcpy(out + 18, date, sizeof date);
+        out[25] = entry.directory ? 2 : 0;
+        both(out + 28, 1, 2);
+        out[32] = static_cast<std::uint8_t>(entry.name.size());
+        std::memcpy(out + 33, entry.name.data(), entry.name.size());
+    }
+    std::uint8_t *sector(std::uint32_t address) { return metadata_.data() + address * kSector; }
+
+    std::uint32_t path_table(std::uint8_t *out, bool big) {
+        std::uint32_t length = 0;
+        for (std::uint32_t i = 0; i < std::size(kDirectories); ++i) {
+            const auto name = i == 0 ? std::string_view("\0", 1) : filename(kDirectories[i]);
+            auto *row = out + length;
+            row[0] = static_cast<std::uint8_t>(name.size());
+            integer(row + 2, kRoot + i, 4, big);
+            integer(row + 6, directory_index(parent(kDirectories[i])) + 1, 2, big);
+            std::memcpy(row + 8, name.data(), name.size());
+            length += static_cast<std::uint32_t>((9 + name.size()) & ~std::size_t{1});
+        }
+        return length;
+    }
+
+    bool build_metadata() {
+        auto *pvd = sector(16);
+        std::memcpy(pvd, "\x01" "CD001\x01", 7);
+        std::fill(pvd + 8, pvd + 72, ' ');
+        std::memcpy(pvd + 8, "PLAYSTATION", 11);
+        std::memcpy(pvd + 40, "SLUS_211.82", 11);
+        both(pvd + 80, kSectors, 4);
+        both(pvd + 120, 1, 2);
+        both(pvd + 124, 1, 2);
+        both(pvd + 128, kSector, 2);
+        const auto table_size = path_table(sector(18), false);
+        path_table(sector(19), true);
+        both(pvd + 132, table_size, 4);
+        integer(pvd + 140, 18, 4, false);
+        integer(pvd + 148, 19, 4, true);
+        record(pvd + 156, {std::string(1, '\0'), kRoot, kSector, true});
+        std::fill(pvd + 190, pvd + 813, ' ');
+        for (unsigned i = 0; i < 4; ++i) std::fill_n(pvd + 813 + 17 * i, 16, '0');
+        pvd[881] = 1;
+        std::memcpy(sector(17), "\xff" "CD001\x01", 7);
+
+        for (std::uint32_t d = 0; d < std::size(kDirectories); ++d) {
+            const auto prefix = kDirectories[d];
+            std::vector<Record> rows{
+                {std::string(1, '\0'), kRoot + d, kSector, true},
+                {std::string(1, '\1'), kRoot + directory_index(parent(prefix)), kSector, true}
+            };
+            for (std::uint32_t i = 1; i < std::size(kDirectories); ++i)
+                if (parent(kDirectories[i]) == prefix)
+                    rows.push_back({std::string(filename(kDirectories[i])), kRoot + i, kSector, true});
+            for (const auto &entry : kFiles)
+                if (parent(entry.path) == prefix)
+                    rows.push_back({std::string(filename(entry.path)) + ";1", entry.sector, entry.size, false});
+            std::sort(rows.begin() + 2, rows.end(), [](const Record &a, const Record &b) { return a.name < b.name; });
+            std::size_t offset = 0;
+            for (const auto &row : rows) {
+                const auto length = record_size(row);
+                if (offset + length > kSector) return false;
+                record(sector(kRoot + d) + offset, row);
+                offset += length;
+            }
+        }
+        return true;
+    }
+};
+
+}
