+    for (std::size_t i = 0; i < road_america_members.size(); ++i) {
+        if (i >= 2 && !(active & (1u << (i - 2)))) continue;
+        const auto &data = mod.data[i];
+        const std::uint64_t offset = std::uint64_t{mod.archive_sector + road_america_members[i].sector} * kSector;
