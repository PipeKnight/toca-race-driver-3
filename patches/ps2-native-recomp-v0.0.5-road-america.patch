+bool prepare_road_america() {
+    const auto &folder = g_road_america_directory;
+    if (folder.empty()) return true;
+    const auto archive = find("RDH_1.HUG");
+    if (!find("SLUS_211.82") || !archive || archive->size != 1546352640u) {
+        std::fprintf(stderr, "[road-america] the add-on requires SLUS-21182 v1.02\n");
+        return false;
+    }
+    auto mod = std::make_unique<RoadAmerica>();
+    mod->archive_sector = archive->sector;
+    for (std::size_t i = 0; i < road_america_members.size(); ++i) {
+        const auto &member = road_america_members[i];
+        const auto filename = os::utf8(os::path(folder) / member.name);
+        std::FILE *file = os::open(filename, "rb");
+        if (!file) {
+            std::fprintf(stderr, "[road-america] could not open %s\n", filename.c_str());
+            return false;
+        }
+        auto &data = mod->data[i];
+        data.resize(member.bytes);
+        const auto size = std::fread(data.data(), 1, data.size(), file);
+        const bool complete = std::fgetc(file) == EOF && !std::ferror(file);
+        std::fclose(file);
+        if (size != data.size() || !complete || std::memcmp(data.data(), member.magic, 4) != 0 ||
+            u32(data.data() + (i < 2 ? 4 : 8)) != member.entries) {
+            std::fprintf(stderr, "[road-america] invalid add-on member %s\n", filename.c_str());
+            return false;
+        }
+    }
+    g_road_america = std::move(mod);
+    std::fprintf(stderr, "[road-america] enabled\n");
+    return true;
