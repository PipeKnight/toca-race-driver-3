+void road_america_path(std::uint32_t address) {
+    if (!g_road_america) return;
+    const auto name = guest_name(address);
+    constexpr std::string_view imported = "TRACKS\\TQA1\\";
+    constexpr std::string_view stock = "TRACKS\\OSC1\\";
+    const bool selected = name.starts_with(imported);
+    if (selected || name.starts_with(stock)) {
+        const auto suffix = name.substr(imported.size());
+        const unsigned flag = suffix == "SUN\\TRACK.JPK" ? 1u : suffix == "SUN\\DMA1.JPK" ? 2u : 0u;
+        if (flag) {
+            if (selected) g_road_america->track_members.fetch_or(flag);
+            else g_road_america->track_members.fetch_and(~flag);
+        }
+        if (selected) std::memcpy(g_ram + address + 7, "OSC1", 4);
+        return;
+    }
+    // Loading-screen and other companion resources use the reference course.
+    if (const auto pos = name.find("TQA1"); pos != std::string_view::npos)
+        std::memcpy(g_ram + address + pos, "OSC1", 4);
+}
+
+std::uint32_t road_america_member(std::uint32_t address, std::uint32_t scratch) {
+    const auto name = guest_name(address);
+    if (!g_road_america || scratch > kRamSize - 128u) return address;
+    const auto pos = name.find("tqa1");
+    if (pos == std::string_view::npos) return address;
+    std::memmove(g_ram + scratch, name.data(), name.size() + 1);
+    std::memcpy(g_ram + scratch + pos, "osc1", 4);
+    return scratch;
+}
 
