+struct DtmResource {
+    const char *name;
+    std::uint32_t sector;
+    std::size_t size;
+};
+
+constexpr std::array dtm_resources{
+    DtmResource{"DTMX.JPK", 187552, 5145344},
+    DtmResource{"DTM_C_KLASSE_HI.MSH", 190800, 369788},
+};
+std::array<std::vector<std::uint8_t>, dtm_resources.size()> g_dtm_overlays;
+std::uint32_t g_dtm_archive_sector;
+std::string g_dtm_mod_directory;
+
+bool valid_dtm_package(const std::vector<std::uint8_t> &data) {
+    constexpr std::size_t count = 57, row_size = 32, directory_end = 32 + count * row_size;
+    if (std::memcmp(data.data(), "JPAK", 4) || u32(data.data() + 8) != count) return false;
+    auto first_data = data.size();
+    for (std::size_t row = 32; row < directory_end; row += row_size) {
+        const auto offset = u32(data.data() + row + 8);
+        const auto bytes = u32(data.data() + row + 4);
+        if (offset < directory_end || offset > data.size() || bytes > data.size() - offset) return false;
+        first_data = std::min(first_data, std::size_t{offset});
+    }
+    for (std::size_t row = 32; row < directory_end; row += row_size) {
+        const auto name = u32(data.data() + row);
+        if (name < directory_end || name >= first_data ||
+            !std::memchr(data.data() + name, 0, first_data - name)) return false;
+    }
+    return true;
+}
+
+bool valid_dtm_hi_mesh(const std::vector<std::uint8_t> &data) {
+    const auto footer = data.size() - 12;
+    const auto count = u32(data.data() + footer);
+    const auto payload = u32(data.data() + footer + 4);
+    if (u32(data.data() + footer + 8) != 0x0abd0be0 || payload % 16 || payload > footer ||
+        (footer - payload) % 8 || (footer - payload) / 8 != count) return false;
+    for (std::size_t row = payload; row < footer; row += 8) {
+        const auto offset = u32(data.data() + row);
+        if (offset >= payload || offset % 4 || u32(data.data() + row + 4) != 4) return false;
+    }
+    return true;
+}
+
+bool prepare_dtm_mod() {
+    if (g_dtm_mod_directory.empty()) return true;
+    const auto archive = find("RDH_2.HUG");
+    if (!find("SLUS_211.82") || !archive || archive->size != 1546364928u) {
+        std::fprintf(stderr, "[dtm-mod] requires SLUS-21182 v1.02\n");
+        return false;
+    }
+    g_dtm_archive_sector = archive->sector;
+    bool present = false;
+    for (std::size_t i = 0; i < dtm_resources.size(); ++i) {
+        const auto &resource = dtm_resources[i];
+        const auto path = os::path(g_dtm_mod_directory) / resource.name;
+        const auto filename = os::utf8(path);
+        std::error_code error;
+        if (!std::filesystem::exists(path, error) && !error) continue;
+        auto *file = os::open(filename, "rb");
+        if (!file) {
+            std::fprintf(stderr, "[dtm-mod] could not open %s\n", filename.c_str());
+            return false;
+        }
+        auto &data = g_dtm_overlays[i];
+        data.resize(resource.size);
+        const auto read = std::fread(data.data(), 1, data.size(), file);
+        const bool complete = std::fgetc(file) == EOF && !std::ferror(file);
+        std::fclose(file);
+        if (read != data.size() || !complete || !(i == 0 ? valid_dtm_package(data) : valid_dtm_hi_mesh(data))) {
+            std::fprintf(stderr, "[dtm-mod] invalid overlay %s\n", filename.c_str());
+            return false;
+        }
+        present = true;
+    }
+    if (!present) std::fprintf(stderr, "[dtm-mod] supply DTMX.JPK or DTM_C_KLASSE_HI.MSH\n");
+    return present;
+}
+
+bool copy_overlay_range(std::uint64_t start, void *out, std::size_t got,
+                        std::uint64_t offset, const std::vector<std::uint8_t> &data) {
+    const auto first = std::max(start, offset);
+    const auto end = std::min(start + got, offset + data.size());
+    if (first >= end) return false;
+    std::memcpy(static_cast<std::uint8_t *>(out) + first - start, data.data() + first - offset, end - first);
+    return first == offset;
+}
+
+void apply_dtm_mod(std::uint32_t sector, void *out, std::size_t got) {
+    const std::uint64_t start = std::uint64_t{sector} * kSector;
+    for (std::size_t i = 0; i < dtm_resources.size(); ++i) {
+        const auto &data = g_dtm_overlays[i];
+        if (data.empty()) continue;
+        const auto &resource = dtm_resources[i];
+        const std::uint64_t offset = std::uint64_t{g_dtm_archive_sector + resource.sector} * kSector;
+        if (copy_overlay_range(start, out, got, offset, data))
+            std::fprintf(stderr, "[dtm-mod] loading %s\n", resource.name);
+    }
+}
