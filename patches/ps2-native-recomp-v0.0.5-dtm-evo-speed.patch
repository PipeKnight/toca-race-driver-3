+static void update_evo_speed(DtmVariant &mod, std::uint64_t frame) {
+    // The PS2M builder identifies the three UV streams in ignored VIF NOP arguments.
+    constexpr std::uint32_t uv_offset = 176;
+    constexpr std::uint32_t uv_bytes = 32;
+    constexpr std::uint32_t limit = kRamSize - uv_offset - uv_bytes - 4;
+    const auto valid = [](std::uint32_t at, std::size_t slot) {
+        return at && !(at & 3u) && at <= limit && ld32(at) == 0x5645 && ld32(at + 4) == 0x374f &&
+               ld32(at + 8) == slot && ld32(at + uv_offset - 4) == 0x74040108u &&
+               ld32(at + uv_offset + uv_bytes) == 0x6e044109u;
+    };
+    bool missing = false;
+    for (std::size_t i = 0; i < mod.evo_digits.size(); ++i)
+        missing |= !valid(mod.evo_digits[i][0], i);
+    if (frame <= mod.previous_gauge_frame || frame % 600 == 0 || (missing && frame % 120 == 0)) {
+        for (auto &group : mod.evo_digits) group.fill(0);
+        const auto *end = g_ram + limit;
+        const auto *at = g_ram;
+        std::array<std::size_t, 3> used{};
+        while (at < end) {
+            const auto *match = static_cast<const std::uint8_t *>(std::memchr(at, 0x45, end - at));
+            if (!match) break;
+            const auto address = static_cast<std::uint32_t>(match - g_ram);
+            if (!(address & 3u) && ld32(address) == 0x5645 && ld32(address + 4) == 0x374f) {
+                const auto slot = ld32(address + 8);
+                if (slot < used.size() && used[slot] < mod.evo_digits[slot].size() && valid(address, slot))
+                    mod.evo_digits[slot][used[slot]++] = address;
+            }
+            at = match + 1;
+        }
+    }
+    mod.previous_gauge_frame = frame;
+
+    // Same SLUS-21182 v1.02 player speed in m/s used by the DB5 gauge.
+    const float speed = std::abs(std::bit_cast<float>(ld32(0x005f49d4u)));
+    if (!std::isfinite(speed) || speed > 250.f) return;
+    const unsigned mph = static_cast<unsigned>(speed * 2.236936f);
+    constexpr std::array<unsigned, 3> places{100, 10, 1};
+    for (std::size_t i = 0; i < places.size(); ++i) {
+        const bool blank = i < 2 && mph < places[i];
+        const unsigned digit = mph / places[i] % 10;
+        const float x = blank ? 126.5f : 96.5f + (digit % 4) * 8;
+        const float y = blank ? 127.5f : 96.5f + (digit / 4) * 10;
+        const float right = x + (blank ? 1.f : 7.f);
+        const float uv[8] = {x / 128, y / 128, x / 128, (y + (blank ? 0 : 9)) / 128,
+                             right / 128, y / 128, right / 128, (y + (blank ? 0 : 9)) / 128};
+        for (const auto address : mod.evo_digits[i]) {
+            if (valid(address, i))
+                std::memcpy(g_ram + address + uv_offset, uv, sizeof(uv));
+        }
+    }
+}
