+// Recognize the TOCA car lighting entries used for bodywork and glass.
+inline bool toca_efu_program(const std::uint8_t *code, std::uint32_t pc) {
+    if (pc != 0x1D10u && pc != 0x2410u && pc != 0x2428u && pc != 0x2A90u) return false;
+    std::uint64_t first_sum, sum_and_read[2];
+    std::memcpy(&first_sum, code + 0x21B0, sizeof first_sum);
+    std::memcpy(sum_and_read, code + 0x2208, sizeof sum_and_read);
+    return first_sum == 0x01C421FF81E05F7Eull &&
+           sum_and_read[0] == 0x01D9632881E03F7Eull &&
+           sum_and_read[1] == 0x01A8529B8027067Cull;
+}
+
+inline unsigned efu_opcode(std::uint32_t lo, std::uint32_t hi) {
+    if ((hi & 0x80000000u) || (lo >> 25) != 0x40u || (lo & 0x3Cu) != 0x3Cu) return 0;
+    return ((lo >> 6) & 31u) * 4u + (lo & 3u);
+}
+
+inline unsigned efu_latency(unsigned op) {
+    constexpr unsigned latency[] = {11, 18, 18, 24, 54, 54, 12, 0, 12, 18, 12, 0, 29, 54, 44};
+    return op >= 0x70u && op <= 0x7Eu ? latency[op - 0x70u] : 0;
+}
 
