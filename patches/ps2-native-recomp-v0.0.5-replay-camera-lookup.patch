+static const std::vector<std::uint8_t> *replay_camera(std::uint32_t address) {
+    if (!g_road_america) return nullptr;
+    const auto &mod = *g_road_america;
+    const auto name = guest_name(address);
+    if (name.size() != 11 || name.substr(4) != "Cam.ini") return nullptr;
+    constexpr std::array keys{"tqa1", "tqa2", "tqa3", "tqa4", "tqa5"};
+    for (unsigned course = 0; course < mod.courses; ++course) {
+        if (name.substr(0, 4) != keys[course]) continue;
+        if (course == 0 && mod.selected[0].load() == road_america_rain && !mod.rain_replay_camera.empty())
+            return &mod.rain_replay_camera;
+        return &mod.replay_cameras[course];
+    }
+    return nullptr;
+}
+
+std::uint32_t replay_camera_size(std::uint32_t name) {
+    const auto *data = replay_camera(name);
+    return data ? static_cast<std::uint32_t>(data->size()) : 0u;
+}
+
+bool copy_replay_camera(std::uint32_t name, std::uint32_t buffer, std::uint32_t size) {
+    const auto *data = replay_camera(name);
+    if (!data || size != data->size() || buffer == 0 || buffer >= kRamSize || size >= kRamSize - buffer)
+        return false;
+    std::memcpy(g_ram + buffer, data->data(), size);
+    g_ram[buffer + size] = 0;
+    return true;
+}
