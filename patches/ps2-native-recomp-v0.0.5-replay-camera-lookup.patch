+bool load_replay_camera(const std::filesystem::path &folder, std::vector<std::uint8_t> &data) {
+    const auto path = folder / "replay-cameras.ini";
+    std::error_code error;
+    if (!std::filesystem::exists(path, error)) return !error;
+    const auto size = std::filesystem::file_size(path, error);
+    if (error || !size || size > 65536u) return false;
+    const auto filename = os::utf8(path);
+    auto *file = os::open(filename, "rb");
+    if (!file) return false;
+    data.resize(static_cast<std::size_t>(size));
+    const bool complete = std::fread(data.data(), 1, data.size(), file) == data.size() &&
+                          std::fgetc(file) == EOF && !std::ferror(file);
+    std::fclose(file);
+    return complete;
+}
