+bool valid_db5_shadow(const std::vector<std::uint8_t> &data) {
+    constexpr std::array<std::string_view, 6> parts{"shadow_main_body", "shadow_roof", "shadow_fl_alloy",
+        "shadow_fr_alloy", "shadow_bl_alloy", "shadow_br_alloy"};
+    if (data.size() < 4 || u32(data.data()) != parts.size()) return false;
+    const auto finite = [](std::uint32_t bits) { return (bits & 0x7f800000u) != 0x7f800000u; };
+    std::size_t at = 4;
+    for (const auto name : parts) {
+        if (data.size() - at < 84 || std::memcmp(data.data() + at, name.data(), name.size()) ||
+            data[at + name.size()]) return false;
+        const auto vertices = u32(data.data() + at + 64);
+        const std::size_t vertex_bytes = 16 * (std::size_t{vertices} + 1);
+        if (vertices < 3 || vertices > 128 || data.size() - at - 68 < vertex_bytes + 4) return false;
+        at += 68;
+        for (std::size_t i = 0; i < vertex_bytes; i += 4)
+            if (!finite(u32(data.data() + at + i))) return false;
+        at += vertex_bytes;
+        const auto faces = u32(data.data() + at);
+        at += 4;
+        if (!faces || faces > 256 || data.size() - at < 28 * faces) return false;
+        for (std::size_t i = 0; i < 12 * faces; i += 4)
+            if (u32(data.data() + at + i) >= vertices) return false;
+        for (std::size_t i = 12 * faces; i < 28 * faces; i += 4)
+            if (!finite(u32(data.data() + at + i))) return false;
+        at += 28 * faces;
+    }
+    return at == data.size();
+}
