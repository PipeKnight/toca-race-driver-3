+    const auto apply_assignment = [&](std::vector<std::uint8_t> &events) {
+        const auto at = std::search(events.begin(), events.end(), assignment.begin(), assignment.end());
+        if (at == events.end()) return false;
+        if (std::search(at + assignment.size(), events.end(), assignment.begin(), assignment.end()) != events.end())
+            return false;
+        const auto number = assignment.find("13/CKL");
+        at[number] = '2';
+        at[number + 1] = '0';
+        return true;
+    };
+    if (!apply_assignment(expected) ||
+        !load_dtm_variant_file(root / "events.big", mod->events, dtm_variant_event_size, dtm_variant_event_size) ||
+        mod->events != expected) {
+        std::fprintf(stderr, "[dtm-mod] invalid introductory race catalog\n");
