+        relative > archive.size / kSector ||
+        !dtm_variant_has_room(archive.sector + dtm_variant_first_sector, archive.sector + relative)) {
+        std::fprintf(stderr, "[dtm-mod] invalid variant archive, model or reference disc padding\n");
+        return false;
+    }
+    std::vector<std::uint8_t> expected(dtm_variant_event_size);
+    const auto offset = std::uint64_t{catalog->sector + dtm_variant_event_sector} * kSector;
