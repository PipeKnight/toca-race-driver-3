+bool load_dtm_variant_file(const std::filesystem::path &path, std::vector<std::uint8_t> &bytes,
+                           std::size_t limit, std::size_t exact) {
+    std::error_code error;
+    const auto size = std::filesystem::file_size(path, error);
+    if (error || !size || size > limit || (exact && size != exact)) return false;
+    const auto filename = os::utf8(path);
+    auto *file = os::open(filename, "rb");
+    if (!file) return false;
+    bytes.resize(static_cast<std::size_t>(size));
+    const auto read = std::fread(bytes.data(), 1, bytes.size(), file);
+    const bool complete = std::fgetc(file) == EOF && !std::ferror(file);
+    std::fclose(file);
+    return read == bytes.size() && complete;
+}
+
+bool dtm_variant_has_room(std::uint32_t first, std::uint32_t last) {
+    std::array<std::uint8_t, 16 * kSector> buffer;
+    auto offset = std::uint64_t{first} * kSector;
+    const auto end = std::uint64_t{last} * kSector;
+    for (; offset < end; offset += buffer.size()) {
+        const auto bytes = static_cast<std::size_t>(std::min<std::uint64_t>(buffer.size(), end - offset));
+        if (g_reader(offset, buffer.data(), bytes) != bytes ||
+            std::any_of(buffer.begin(), buffer.begin() + bytes, [](std::uint8_t byte) { return byte != 0; }))
+            return false;
+    }
+    return true;
+}
