+            std::fprintf(stderr, "[dtm-mod] missing or invalid variant asset %s\n", descriptor.name);
+            return false;
+        }
+        mod->sectors[i] = relative;
+        relative += static_cast<std::uint32_t>((mod->files[i].size() + kSector - 1) / kSector);
+    }
+    const auto catalog = find("RDH_1.HUG");
