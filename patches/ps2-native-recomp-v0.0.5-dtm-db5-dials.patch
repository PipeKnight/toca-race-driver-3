+void update_db5_gauges(std::uint64_t frame) {
+    if (!g_dtm_variant || !g_dtm_variant->db5_dials) return;
+    auto &mod = *g_dtm_variant;
+    // The generated PS2M stores the identifiers as VIF NOP arguments. Only touch
+    // aligned packets whose following command unpacks exactly three needle vertices.
+    constexpr std::array<std::uint32_t, 2> kinds{0x5053, 0x5052};
+    constexpr std::array<float, 2> center{.252f, .432f};
+    constexpr std::uint32_t vertex_offset = 220;
+    const auto valid = [](std::uint32_t at, std::uint32_t kind) {
+        return at && !(at & 3u) && at <= kRamSize - vertex_offset - 36 &&
+               ld32(at) == 0x4244 && ld32(at + 4) == 0x3535 && ld32(at + 8) == kind &&
+               ld32(at + vertex_offset - 4) == 0x6803010au;
+    };
+    const bool missing =
+        !valid(mod.gauge_streams[0][0], kinds[0]) || !valid(mod.gauge_streams[1][0], kinds[1]);
+    if (frame <= mod.previous_gauge_frame || frame % 600 == 0 || (missing && frame % 120 == 0)) {
+        for (auto &group : mod.gauge_streams) group.fill(0);
+        const auto *end = g_ram + kRamSize - vertex_offset - 36;
+        const auto *at = g_ram;
+        std::array<std::size_t, 2> used{};
+        while (at < end) {
+            const auto *match = static_cast<const std::uint8_t *>(std::memchr(at, 0x44, end - at));
+            if (!match) break;
+            const auto address = static_cast<std::uint32_t>(match - g_ram);
+            for (std::size_t i = 0; i < kinds.size(); ++i) {
+                if (used[i] < mod.gauge_streams[i].size() && valid(address, kinds[i]))
+                    mod.gauge_streams[i][used[i]++] = address;
+            }
+            if (used[0] == mod.gauge_streams[0].size() && used[1] == mod.gauge_streams[1].size()) break;
+            at = match + 1;
+        }
+    }
+    mod.previous_gauge_frame = frame;
+
+    // SLUS-21182 v1.02 publishes the active speed in m/s and the engine rev fraction.
+    // The speedometer spans 160 mph; the tachometer spans the game's normalized rev range.
+    const float speed = std::bit_cast<float>(ld32(0x005f49d4u));
+    const float revs = std::bit_cast<float>(ld32(0x0057259cu));
+    const std::array<float, 2> values{speed * (2.236936f / 160.f), revs};
+    for (std::size_t i = 0; i < values.size(); ++i) {
+        if (!std::isfinite(values[i]) || values[i] < -.025f || values[i] > 1.5f) continue;
+        const float angle = 3.926990817f - 4.71238898f * std::clamp(values[i], 0.f, 1.f);
+        const float x = std::cos(angle), y = std::sin(angle);
+        const float vertices[9] = {
+            center[i] - y * .0022f, .81f + x * .0022f, .157f,
+            center[i] + y * .0022f, .81f - x * .0022f, .157f,
+            center[i] + x * .0504f, .81f + y * .0504f, .157f,
+        };
+        for (const auto address : mod.gauge_streams[i]) {
+            if (valid(address, kinds[i]))
+                std::memcpy(g_ram + address + vertex_offset, vertices, sizeof(vertices));
+        }
+    }
+}
