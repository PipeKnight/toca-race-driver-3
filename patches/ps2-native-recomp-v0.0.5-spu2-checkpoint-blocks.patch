diff --git a/tests/spu2_envx_state.cpp b/tests/spu2_envx_state.cpp
--- a/tests/spu2_envx_state.cpp
+++ b/tests/spu2_envx_state.cpp
@@ -48,6 +48,51 @@
     write(kAdsr1, kFastAttack);
     write(kAdsr2, 0x1FC0);
     write(kKeyOn, 1);
+}
+
+void check_buffered_end_flags() {
+    constexpr std::uint32_t kSecondCore = 0x400;
+    constexpr std::uint32_t kPitch = 0x004;
+    constexpr std::uint32_t kSampleStartLow = 0x1C2;
+    constexpr std::uint32_t kEndx = 0x340;
+    constexpr std::uint32_t kFirstSample = 0x5000;
+    constexpr std::uint32_t kSecondSample = 0x6000;
+    constexpr std::uint32_t kBlockWords = 8;
+    constexpr std::uint16_t kEndBlock = 0x0100;
+
+    iop::reset();
+    spu::ram()[kSecondSample + kBlockWords] = kEndBlock;
+    for (const auto core : {0u, kSecondCore}) {
+        write(core + kAdsr1, kFastAttack);
+        write(core + kAdsr2, 0x1FC0);
+        write(core + kPitch, 0x1000);
+        write(core + kSampleStartLow, core == 0 ? kFirstSample : kSecondSample);
+        write(core + kKeyOn, 1);
+    }
+
+    // A streaming write can overwrite an ADPCM header after the voice has buffered it.
+    spu::ram()[kFirstSample] = kEndBlock;
+    spu::ram()[kSecondSample + kBlockWords] = 0;
+    const auto checkpoint = save_iop(11);
+    const auto legacy = save_iop(10);
+
+    const auto play = [&] { iop::run(65 * kEeCyclesPerSample); };
+    const auto check = [&](const char *first, const char *second) {
+        expect(spu::read(kEndx, 2) & 1u, 0, first);
+        expect(spu::read(kSecondCore + kEndx, 2) & 1u, 1, second);
+    };
+
+    play();
+    check("a live voice continues after its buffered header is changed", "a live voice still ends at its buffered end block");
+
+    restore_iop(checkpoint);
+    play();
+    check("checkpoint retains the original current block flag", "checkpoint retains the original next block flag on core 1");
+
+    restore_iop(legacy);
+    play();
+    expect(spu::read(kEndx, 2) & 1u, 1, "legacy checkpoint derives the current block flag from RAM");
+    expect(spu::read(kSecondCore + kEndx, 2) & 1u, 0, "legacy checkpoint derives the next block flag from RAM");
 }
 }

