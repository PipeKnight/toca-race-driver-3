+// The guest sees host input at the next vblank, just as it does during a game.
+void poll_frame() {
+    poll_input();
+    const auto cycles = ps2::scheduled_at(ps2::hw::kEventVblank) - ps2::now();
+    ps2::set_budget(ps2::g_cpu, static_cast<std::int64_t>(cycles));
+    ps2::g_cpu.budget = 0;
+    ps2::preempt(ps2::g_cpu);
+}
