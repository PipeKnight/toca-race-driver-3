+// The JPAK directory and its name strings have already been validated.
+std::span<const std::uint8_t> raw_variant_member(const std::vector<std::uint8_t> &data, std::string_view name) {
+    constexpr std::size_t header_size = 32, row_size = 32;
+    const auto end = header_size + u32(data.data() + 8) * row_size;
+    for (std::size_t row = header_size; row < end; row += row_size) {
+        const auto *entry = data.data() + row;
+        if (name != reinterpret_cast<const char *>(data.data() + u32(entry))) continue;
+        const auto stored = u32(entry + 4);
+        if (stored != u32(entry + 12)) return {};
+        return {data.data() + u32(entry + 8), stored};
+    }
+    return {};
+}
+
+bool replace_event_text(std::string &text, std::string_view before, std::string_view after) {
+    const auto at = text.find(before);
+    if (at == std::string::npos || text.find(before, at + before.size()) != std::string::npos)
+        return false;
+    text.replace(at, before.size(), after);
+    return true;
+}
+
+bool append_free_race_driver(std::vector<std::uint8_t> &events) {
+    constexpr std::size_t directory_start = 0x24, row_size = 24;
+    if (events.size() < directory_start || std::memcmp(events.data(), "BIGF", 4)) return false;
+    const auto count = u32(events.data() + 4);
+    const auto base = u32(events.data() + 8);
+    if (base < directory_start || base > events.size() || count > (base - directory_start) / row_size)
+        return false;
+    const auto directory_end = directory_start + count * row_size;
+    const auto original = events;
+    bool found_dtm = false;
+    std::size_t offset = base;
+    for (std::size_t row = directory_start; row < directory_end; row += row_size) {
+        const auto old_size = u32(original.data() + row + 16);
+        const auto old_offset = u32(original.data() + row + 20);
+        if (old_offset > original.size() - base || old_size > original.size() - base - old_offset)
+            return false;
+        const auto *data = original.data() + base + old_offset;
+        std::size_t size = old_size;
+        std::string modified;
+        if (!std::memcmp(original.data() + row, "dtmxf.ini", sizeof("dtmxf.ini"))) {
+            if (found_dtm) return false;
+            found_dtm = true;
+            modified.assign(reinterpret_cast<const char *>(data), size);
+            const auto first = modified.find("[Driver 13]\r\n");
+            const auto last = modified.find("[Driver 14]\r\n");
+            if (first == std::string::npos || last == std::string::npos || last <= first) return false;
+            auto driver = modified.substr(first, last - first);
+            if (!replace_event_text(driver, "[Driver 13]", "[Driver 21]") ||
+                !replace_event_text(driver, "Name = Alexandros Margaritis", "Name = QA Touring") ||
+                !replace_event_text(driver, "CarUID = dtmx_13/CKL", "CarUID = dtmx_20/CKL") ||
+                !replace_event_text(driver, "DriverNumber = 17", "DriverNumber = 99") ||
+                !replace_event_text(modified, "DriversNum = 20\r\n", "DriversNum = 21\r\n") ||
+                !replace_event_text(modified, "[CarPartUpgrades]", driver + "[CarPartUpgrades]"))
+                return false;
+            data = reinterpret_cast<const std::uint8_t *>(modified.data());
+            size = modified.size();
+        }
+        if (offset > events.size() || size > events.size() - offset) return false;
+        const auto write32 = [&](std::size_t at, std::uint32_t value) {
+            for (unsigned i = 0; i < 4; ++i)
+                events[at + i] = static_cast<std::uint8_t>(value >> (i * 8));
+        };
+        write32(row + 16, static_cast<std::uint32_t>(size));
+        write32(row + 20, static_cast<std::uint32_t>(offset - base));
+        std::memcpy(events.data() + offset, data, size);
+        offset += (size + 31) & ~std::size_t{31};
+    }
+    return found_dtm;
+}
