diff --git a/host/dvd_read.cpp b/host/dvd_read.cpp
new file mode 100644
--- /dev/null
+++ b/host/dvd_read.cpp
@@ -0,0 +1,48 @@
+#include "dvd_chd.hpp"
+
+#ifdef _WIN32
+#include <fcntl.h>
+#endif
+
+namespace {
+
+constexpr std::size_t kReadLimit = 4 * 1024 * 1024;
+
+// Setup reads from one open image. The first line is the decoded size. Each
+// request is a byte offset and count, followed by exactly that many bytes.
+int serve(const std::string &path) {
+    ps2::disc::DvdChd dvd;
+    if (!dvd.open(path)) return 2;
+    if (std::printf("%llu\n", static_cast<unsigned long long>(dvd.size())) < 0 ||
+        std::fflush(stdout) != 0) return 2;
+
+    std::vector<std::uint8_t> buffer(kReadLimit);
+    char line[96];
+    while (std::fgets(line, sizeof line, stdin)) {
+        unsigned long long offset = 0;
+        unsigned long long count = 0;
+        char trailing;
+        if (std::sscanf(line, "%llu %llu %c", &offset, &count, &trailing) != 2 ||
+            count == 0 || count > kReadLimit || offset > dvd.size() || count > dvd.size() - offset) return 2;
+        const auto size = static_cast<std::size_t>(count);
+        if (dvd.read(offset, buffer.data(), size) != size) {
+            std::fprintf(stderr, "[disc] %s: cannot read DVD data at byte %llu\n", path.c_str(), offset);
+            return 2;
+        }
+        if (std::fwrite(buffer.data(), 1, size, stdout) != size || std::fflush(stdout) != 0) return 2;
+    }
+    return std::ferror(stdin) ? 2 : 0;
+}
+
+}
+
+#ifdef _WIN32
+int wmain(int argc, wchar_t **argv) {
+    if (argc != 2 || _setmode(_fileno(stdout), _O_BINARY) == -1) return 2;
+    return serve(ps2::os::utf8(argv[1]));
+}
+#else
+int main(int argc, char **argv) {
+    return argc == 2 ? serve(argv[1]) : 2;
+}
+#endif
