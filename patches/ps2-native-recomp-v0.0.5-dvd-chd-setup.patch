+class ChdFile:
+    """A read-only view of the decoded DVD, backed by the native CHD reader."""
+
+    max_read = 4 * 1024 * 1024
+
+    def __init__(self, path):
+        reader = os.environ.get('PS2_DVD_READER')
+        if not reader:
+            raise OSError('DVD CHD input requires PS2_DVD_READER')
+        self.path = path
+        self.pos = 0
+        self.process = subprocess.Popen([reader, path], stdin=subprocess.PIPE, stdout=subprocess.PIPE)
+        try:
+            self.size = int(self.process.stdout.readline(32))
+            if self.size <= 0:
+                raise ValueError('invalid DVD size')
+        except ValueError as error:
+            self.close()
+            raise OSError(f'{path}: could not open DVD CHD') from error
+
+    def seek(self, offset):
+        if offset < 0:
+            raise ValueError('negative DVD seek')
+        self.pos = offset
+
+    def read(self, size):
+        remaining = min(size, self.size - self.pos)
+        data = bytearray()
+        while remaining > 0:
+            count = min(remaining, self.max_read)
+            try:
+                self.process.stdin.write(f'{self.pos} {count}\n'.encode('ascii'))
+                self.process.stdin.flush()
+                chunk = self.process.stdout.read(count)
+                if len(chunk) != count:
+                    raise OSError('short read from DVD reader')
+            except OSError as error:
+                raise OSError(f'{self.path}: cannot decode DVD at byte {self.pos}') from error
+            data.extend(chunk)
+            self.pos += count
+            remaining -= count
+        return data
+
+    def close(self):
+        try:
+            self.process.stdin.close()
+        except BrokenPipeError:
+            pass
+        finally:
+            self.process.stdout.close()
+            self.process.wait()
 
 
