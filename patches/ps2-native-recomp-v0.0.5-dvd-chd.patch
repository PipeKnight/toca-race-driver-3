diff --git a/runtime/src/dvd_chd.hpp b/runtime/src/dvd_chd.hpp
new file mode 100644
--- /dev/null
+++ b/runtime/src/dvd_chd.hpp
@@ -0,0 +1,82 @@
+#pragma once
+
+#include "ps2/disc.hpp"
+#include "ps2/os.hpp"
+
+#include <libchdr/chd.h>
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <memory>
+
+namespace ps2::disc {
+
+class DvdChd {
+public:
+    bool open(const std::string &path) {
+        file_.reset(os::open(path, "rb"));
+        if (!file_) return fail(path, "cannot open file");
+
+        chd_file *image = nullptr;
+        const auto open_error = chd_open_file(file_.get(), CHD_OPEN_READ, nullptr, &image);
+        if (open_error != CHDERR_NONE) return fail(path, "cannot open CHD", open_error);
+        image_.reset(image);
+
+        const auto &header = *chd_get_header(image_.get());
+        constexpr std::uint32_t max_hunk_size = 512 * 1024;
+        constexpr std::uint64_t max_dvd_size = 9'000'000'000;
+        if (header.version != 5 || header.unitbytes != kSector ||
+            !header.logicalbytes || header.logicalbytes > max_dvd_size ||
+            header.logicalbytes % kSector || header.hunkbytes % kSector ||
+            !header.hunkbytes || header.hunkbytes > max_hunk_size)
+            return fail(path, "expected a CHDv5 DVD image with 2048-byte sectors");
+
+        char dvd_metadata = 0;
+        if (chd_get_metadata(image_.get(), DVD_METADATA_TAG, 0, &dvd_metadata, sizeof dvd_metadata,
+                             nullptr, nullptr, nullptr) != CHDERR_NONE)
+            return fail(path, "missing DVD metadata");
+
+        size_ = header.logicalbytes;
+        hunk_.resize(header.hunkbytes);
+        return true;
+    }
+
+    std::uint64_t size() const { return size_; }
+
+    std::size_t read(std::uint64_t offset, void *output, std::size_t count) {
+        if (offset >= size_) return 0;
+        const auto wanted = static_cast<std::size_t>(std::min<std::uint64_t>(count, size_ - offset));
+        auto *out = static_cast<std::uint8_t *>(output);
+        std::size_t copied = 0;
+        while (copied < wanted) {
+            const auto position = offset + copied;
+            const auto index = static_cast<std::uint32_t>(position / hunk_.size());
+            if (cached_index_ != index) {
+                cached_index_ = std::numeric_limits<std::uint32_t>::max();
+                if (chd_read(image_.get(), index, hunk_.data()) != CHDERR_NONE) return copied;
+                cached_index_ = index;
+            }
+            const auto start = static_cast<std::size_t>(position % hunk_.size());
+            const auto step = std::min(wanted - copied, hunk_.size() - start);
+            std::memcpy(out + copied, hunk_.data() + start, step);
+            copied += step;
+        }
+        return copied;
+    }
+
+private:
+    static bool fail(const std::string &path, const char *why, chd_error detail = CHDERR_NONE) {
+        std::fprintf(stderr, "[disc] %s: %s%s%s\n", path.c_str(), why,
+                     detail == CHDERR_NONE ? "" : ": ", detail == CHDERR_NONE ? "" : chd_error_string(detail));
+        return false;
+    }
+
+    std::unique_ptr<std::FILE, decltype(&std::fclose)> file_{nullptr, std::fclose};
+    std::unique_ptr<chd_file, decltype(&chd_close)> image_{nullptr, chd_close};
+    std::vector<std::uint8_t> hunk_;
+    std::uint64_t size_ = 0;
+    std::uint32_t cached_index_ = std::numeric_limits<std::uint32_t>::max();
+};
+
+}
