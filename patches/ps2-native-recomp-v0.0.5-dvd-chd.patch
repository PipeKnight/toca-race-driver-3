+#ifdef PS2_DVD_CHD
+bool write_dvd_chd(const std::string &path, std::FILE *output) {
+    DvdChd image;
+    if (!image.open(path)) return false;
+    std::vector<std::uint8_t> chunk(1024 * 1024);
+    for (std::uint64_t offset = 0; offset < image.size(); offset += chunk.size()) {
+        const auto count = static_cast<std::size_t>(std::min<std::uint64_t>(chunk.size(), image.size() - offset));
+        if (image.read(offset, chunk.data(), count) != count) {
+            std::fprintf(stderr, "[disc] %s: cannot decode the DVD at byte %llu\n", path.c_str(),
+                         static_cast<unsigned long long>(offset));
+            return false;
+        }
+        if (std::fwrite(chunk.data(), 1, count, output) != count) return false;
+    }
+    return std::fflush(output) == 0;
+}
+#endif
 
