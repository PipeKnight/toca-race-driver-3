--- /dev/null
+++ b/tests/spu2_envx_state.cpp
@@ -0,0 +1,106 @@
+#include "iop/iop.hpp"
+#include "iop/spu2.hpp"
+#include "ps2/state.hpp"
+
+#include <cstdint>
+#include <cstdio>
+
+namespace {
+namespace iop = ps2::iop;
+namespace spu = ps2::iop::spu2;
+
+constexpr std::uint32_t kAdsr1 = 0x006;
+constexpr std::uint32_t kAdsr2 = 0x008;
+constexpr std::uint32_t kEnvx = 0x00A;
+constexpr std::uint32_t kKeyOn = 0x1A0;
+constexpr std::uint32_t kKeyOff = 0x1A4;
+constexpr std::uint32_t kFastAttack = 0x000F;
+constexpr std::uint32_t kSlowAttack = 0x7F0F;
+constexpr std::uint64_t kEeCyclesPerSample = iop::kClockDivider * 768;
+int checks = 0;
+int failures = 0;
+
+void expect(std::uint32_t actual, std::uint32_t expected, const char *message) {
+    ++checks;
+    if (actual == expected) return;
+    ++failures;
+    std::fprintf(stderr, "FAIL: %s (got 0x%X, expected 0x%X)\n", message, actual, expected);
+}
+
+void write(std::uint32_t address, std::uint32_t value) { spu::write(address, value, 2); }
+std::uint32_t read() { return spu::read(kEnvx, 2); }
+
+ps2::state::Writer save_iop(std::uint32_t version) {
+    ps2::state::Writer state;
+    state.set_version(version);
+    iop::state(state);
+    return state;
+}
+
+void restore_iop(const ps2::state::Writer &saved) {
+    ps2::state::Reader state(saved.out.data(), saved.out.size());
+    state.set_version(saved.version());
+    iop::state(state);
+}
+
+void start_voice() {
+    iop::reset();
+    write(kAdsr1, kFastAttack);
+    write(kAdsr2, 0x1FC0);
+    write(kKeyOn, 1);
+}
+}
+
+int main() {
+    start_voice();
+    expect(read(), 0, "key-on begins with a zero envelope");
+    iop::run(kEeCyclesPerSample + kEeCyclesPerSample / 2);
+    const auto pending = save_iop(10);
+    iop::run(kEeCyclesPerSample / 2);
+    expect(read(), 0x7000, "two elapsed samples advance fast attack twice");
+    restore_iop(pending);
+    expect(read(), 0x3800, "restore before the first ENVX read retains the first sample");
+    iop::run(kEeCyclesPerSample / 2);
+    expect(read(), 0x7000, "restore retains the sub-sample remainder");
+
+    start_voice();
+    iop::run(kEeCyclesPerSample);
+    write(kAdsr1, kSlowAttack);
+    expect(read(), 0x3800, "an ADSR write preserves elapsed attack at the previous rate");
+    const auto changed = save_iop(10);
+    iop::run(3 * kEeCyclesPerSample);
+    expect(read(), 0x3800, "the new slow attack rate applies to subsequent samples");
+    restore_iop(changed);
+    iop::run(3 * kEeCyclesPerSample);
+    expect(read(), 0x3800, "a checkpoint retains the result of the mid-batch write");
+    write(kKeyOff, 1);
+    iop::run(kEeCyclesPerSample);
+    expect(read(), 0, "key-off releases the projected envelope");
+    restore_iop(changed);
+    write(kEnvx, 0x1234);
+    expect(read(), 0x1234, "an ENVX write updates the value visible before mixing");
+
+    start_voice();
+    iop::run(kEeCyclesPerSample);
+    expect(read(), 0x3800, "legacy fixture begins with an active projection");
+    const auto legacy = save_iop(9);
+    restore_iop(legacy);
+    expect(read(), 0, "legacy checkpoint loads without transient data");
+    iop::run(33 * kEeCyclesPerSample);
+    expect(read() != 0, 1, "the regular mixer still advances a voice restored by a legacy checkpoint");
+
+    start_voice();
+    constexpr std::uint32_t kSecondCore = 0x400;
+    constexpr std::uint32_t kVoice17 = 0x110;
+    write(kSecondCore + kVoice17 + kAdsr1, kFastAttack);
+    write(kSecondCore + kKeyOn + 2, 2);
+    iop::run(kEeCyclesPerSample);
+    expect(spu::read(kSecondCore + kVoice17 + kEnvx, 2), 0x3800, "core 1 high voice bit selects voice 17");
+    write(kSecondCore + kVoice17 + kAdsr1, kSlowAttack);
+    iop::run(kEeCyclesPerSample);
+    expect(read(), 0x7000, "a configuration write in core 1 leaves core 0's envelope independent");
+    expect(spu::read(kSecondCore + kVoice17 + kEnvx, 2), 0x3800, "only the selected voice uses the new rate");
+
+    std::printf("%d SPU2 checks, %d failed\n", checks, failures);
+    return failures != 0;
+}
