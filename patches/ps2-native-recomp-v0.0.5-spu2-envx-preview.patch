+void advance_early_envelope(EarlyEnvelope &early, const Voice &voice) {
+    if (!early.active) return;
+    // The next scheduled mixer tick takes over. The bound also limits a malformed checkpoint.
+    const std::uint64_t until = std::min(kernel::now(), g_next_tick);
+    if (until < early.cycle) return;
+    const std::uint64_t samples = std::min<std::uint64_t>((until - early.cycle) / kCyclesPerSample, kBatch);
+    for (std::uint64_t n = 0; n < samples; ++n)
+        update_envelope(early.value, early.phase, voice.adsr1, voice.adsr2);
+    early.cycle += samples * kCyclesPerSample;
+}
